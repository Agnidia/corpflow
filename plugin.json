{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "corpflow",
  "version": "4.1.2",
  "description": "Staged worktask pipeline with a durable state ledger, cross-plugin delegation, and dependency-DAG orchestration.",
  "author": {
    "name": "Agnidia",
    "email": "support@agnidia.com",
    "url": "https://github.com/Agnidia"
  },
  "homepage": "https://github.com/Agnidia/corpflow",
  "repository": "https://github.com/Agnidia/corpflow",
  "license": "Apache-2.0",
  "keywords": [
    "worktask",
    "agent-orchestration",
    "state-ledger",
    "project-management",
    "developer-review",
    "qa-testing"
  ],
  "extensions": {
    "com.openai": {
      "hooks": "./hooks/codex-hooks.json",
      "interface": {
        "displayName": "Corpflow",
        "shortDescription": "Staged engineering worktasks for Codex",
        "longDescription": "Plan, implement, review, test, document, and finalize engineering work through a durable multi-agent workflow.",
        "developerName": "Agnidia",
        "category": "Productivity",
        "capabilities": ["Read", "Write", "Interactive"],
        "websiteURL": "https://github.com/Agnidia/corpflow",
        "defaultPrompt": [
          "Use Corpflow to plan this engineering task.",
          "Run a Corpflow worktask for this change.",
          "Review this repository with Corpflow."
        ]
      }
    }
  }
}
