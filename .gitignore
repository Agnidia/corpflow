.context/images/*/oversize/

# Swift Package Manager build artifacts (template examples should not commit them)
.build/
.swiftpm/
Package.resolved
__pycache__
*.pyc
*.pyo

# benchmark: per-run generated apps + scratch (gitignored per AC-9; history.json is TRACKED)
benchmark/workdirs/
# Deterministic detail records are free to reproduce, so they stay untracked.
# Live records are NOT ignored: each costs real spend and is the only evidence of
# the run that produced it — every findings doc cites them as its data source.
benchmark/results/runs/deterministic/
!benchmark/results/runs/.gitkeep

# kcov coverage output
.coverage-kcov/

# Captured skill-eval responses — regenerate with evals/scripts/eval-capture.py.
# Unlike benchmark live records above, these stay untracked: a clone re-captures
# rather than inheriting them, so a grade cites the local run's own provenance.
skills/*/evals/responses*/

# Review page embeds the gitignored responses; regenerate with build-review-page.py
evals/review/

# Worktask run state, logs and the user-decision ledger (0600, verbatim answer text)
/.context/

# Per-user Claude Code settings: each operator's own plugin and permission choices
/.claude/settings.local.json
