{
  "name": "corpflow",
  "description": "Staged worktask pipeline (PL→AR→TL→DV→DR→SR→QA→DC→RE→FN→ST) with a durable state ledger, cross-plugin delegation, and /megatask dependency-DAG orchestration of many worktasks across a GitHub milestone.",
  "version": "4.1.3",
  "author": {
    "name": "Agnidia",
    "email": "support@agnidia.com"
  },
  "keywords": [
    "worktask",
    "task-management",
    "state-ledger",
    "stage-contracts",
    "approval-gates",
    "agent-orchestration",
    "megatask",
    "dependency-dag",
    "project-management",
    "developer-review",
    "security-review",
    "qa-testing",
    "release-engineering",
    "incident-response",
    "self-improvement"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Skill|Agent|mcp__.*test.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/test-execution-gate.sh",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/anchor-preflight.sh",
            "args": [
              "--event",
              "pre"
            ]
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/user-decision-record.sh",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/audit-tooluse.sh",
            "args": [
              "--kind",
              "tool"
            ],
            "continueOnBlock": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/anchor-preflight.sh",
            "args": [
              "--event",
              "post"
            ],
            "continueOnBlock": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/comment-standard-context.sh",
            "continueOnBlock": true
          }
        ]
      },
      {
        "matcher": "Bash|Skill|Agent|mcp__.*test.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/test-execution-promote.sh",
            "continueOnBlock": true
          }
        ]
      },
      {
        "matcher": "^(AskUserQuestion|mcp__[A-Za-z0-9_-]+__AskUserQuestion)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/user-decision-record.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Skill|Agent|mcp__.*test.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/test-execution-promote.sh",
            "continueOnBlock": true
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/model-switch-gate.sh",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/model-switch-audit.sh",
            "continueOnBlock": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/audit-subagent.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dv-screenshot-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dv-comment-density-gate.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/state-merge.sh",
            "continueOnBlock": true
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/megatask-monitor.sh",
            "continueOnBlock": true
          }
        ]
      },
      {
        "matcher": "^corpflow:product-manager$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agent-stop.sh",
            "args": [
              "--stage",
              "PL"
            ]
          }
        ]
      },
      {
        "matcher": "^corpflow:project-manager$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agent-stop.sh",
            "args": [
              "--stage",
              "FN"
            ]
          }
        ]
      },
      {
        "matcher": "^corpflow:stakeholder$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agent-stop.sh",
            "args": [
              "--stage",
              "ST"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/precompact-checkpoint.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/skills/context-compression/scripts/post-compact-recovery.sh",
            "continueOnBlock": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-end-finalize.sh",
            "timeout": 5,
            "continueOnBlock": true
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/permission-denied.sh",
            "timeout": 5,
            "continueOnBlock": true
          }
        ]
      }
    ]
  }
}
