#!/usr/bin/env python3
"""Prepare trials, bind trusted-host evidence, and analyze utilization experiments."""

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from benchmarklive import experiment


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    prepare = commands.add_parser("prepare")
    prepare.add_argument("--baseline-root", required=True)
    prepare.add_argument("--optimized-root", required=True)
    prepare.add_argument("--common-fixes-root", required=True)
    prepare.add_argument("--output-dir", required=True)
    prepare.add_argument("--pairs", type=int, default=3)
    prepare.add_argument("--required-finding", action="append", default=[])
    trial = commands.add_parser("prepare-trial")
    trial.add_argument("--manifest", required=True)
    trial.add_argument("--variant", choices=experiment.VARIANTS, required=True)
    trial.add_argument("--run-id", required=True)
    trial.add_argument("--app", required=True)
    trial.add_argument("--record", required=True)
    native = commands.add_parser("validate-native", help="run fresh Unicode and native acceptance on the trusted host")
    native.add_argument("--manifest", required=True)
    native.add_argument("--preparation-receipt", required=True)
    for name in ("verify", "analyze"):
        command = commands.add_parser(name)
        command.add_argument("--manifest", required=True)
        if name == "analyze":
            command.add_argument("--assignments", required=True)
            command.add_argument("--output", required=True)
    args = parser.parse_args()
    try:
        if args.command == "prepare":
            manifest = experiment.prepare(args.baseline_root, args.optimized_root, args.common_fixes_root,
                                          args.output_dir, args.pairs, args.required_finding)
            print(json.dumps({"manifest_id": manifest["manifest_id"], "status": manifest["status"],
                              "manifest": str(Path(args.output_dir) / "manifest.json"),
                              "live_execution": manifest["live_execution"]}, indent=2))
        else:
            manifest = experiment.read_json(args.manifest)
            problems = experiment.verify(manifest, Path(args.manifest).resolve().parent)
            if problems:
                raise ValueError("; ".join(problems))
            if args.command == "prepare-trial":
                result = experiment.prepare_trial(manifest, Path(args.manifest).resolve().parent,
                                                  args.variant, args.run_id, args.app, args.record)
                print(json.dumps(result, indent=2))
            elif args.command == "validate-native":
                result = experiment.validate_native(manifest, Path(args.manifest).resolve().parent,
                                                    args.preparation_receipt)
                print(json.dumps(result, indent=2))
                return 0 if result["status"] == "passed" else 1
            elif args.command == "verify":
                print(json.dumps({"status": "verified_offline", "manifest_id": manifest["manifest_id"]}))
            else:
                assignments_path = Path(args.assignments).resolve()
                result = experiment.analyze(manifest, experiment.read_json(assignments_path), assignments_path.parent)
                destination = Path(args.output)
                with destination.open("x", encoding="utf-8") as stream:
                    stream.write(json.dumps(result, indent=2, ensure_ascii=False) + "\n")
                print(json.dumps({"status": result["status"], "report": str(destination)}))
        return 0
    except (OSError, ValueError, TypeError, KeyError, SyntaxError) as exc:
        print(f"bench-experiment: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
