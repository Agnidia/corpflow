#!/usr/bin/env python3
"""bench-live — live A/B dispatch executable (the ONLY entrypoint importing benchmarklive).

Frozen seam argv (run-benchmark.sh --live):
  bench-live --workdir <run_id> --budget <usd> --record <path>
  [--stages CODE[,CODE...]] [--capture json|stream-json] [--benchmark-dir D] [--prompts-dir D]
  [--without-arm real|skip] [--arm with|without|both] [--config-dir D] [--workdir-root D]
  [--wait-on-limit | --no-wait-on-limit]
  [--provider claude|codex]
--workdir-root (else BENCH_WORKDIR_ROOT, else ${TMPDIR:-/tmp}/corpflow-bench) holds the
per-arm workdirs <root>/<run_id>/{with,without}, kept outside the repo, one git repo per arm.
--config-dir (else BENCH_CONFIG_DIR, else ~/.claude-eval) is the CLAUDE_CONFIG_DIR both
arms and the login probe run under; the operator's own config never reaches a run.
--without-arm overrides the default WITHOUT-baseline policy (real on a full run,
skip on a genuine --stages subset; --stages naming every stage is a full run —
see benchmarklive.baseline.resolve_arm_mode).
--arm with|without records a single arm on its own; --arm both is the paired run.
Left unset it defers to the --without-arm policy, which is what keeps the
pre-existing default byte-stable.
--wait-on-limit (the default) sleeps through the account's rolling usage limit, to the
reset plus a 2-minute margin (6h cap), and re-dispatches only the stage that hit it;
--no-wait-on-limit ends the run instead.
A paired run (claude or codex) writes each finished arm, graded, to
results/runs/live-arm/<run_id>-<arm>.json so bench-pair can join it with a later --arm
run if the other arm is killed. A claude run first probes both arms' plugin sets with
one cheap call each.
Exit codes: 0 ok / 1 the WITH ledger could not be seeded, nothing dispatched / 2 pre-flight
decline / 3 no credential / 4 running-tally breach (partial written first) / 5 the plugin
preflight refused (nothing dispatched), an arm's loaded plugins broke its contract, or
either arm read a plugin cache outside its config dir /
6 usage limit, waiting off or over the cap (partial written, reset time in the message) /
64 bad usage.
"""

import os
import sys
import math

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from benchmarklive import baseline as baseline_mod
from benchmarklive import budget as budget_mod
from benchmarklive import dispatch as dispatch_mod


def die(message, code):
    sys.stderr.write(message + "\n")
    sys.exit(code)


def main(argv):
    workdir = record = stages_arg = benchmark_dir_arg = prompts_dir_arg = None
    without_arm_arg = arm_arg = config_dir_arg = workdir_root_arg = None
    budget = None
    capture_arg = "stream-json"
    wait_on_limit = True
    provider = "claude"

    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print("bench-live --workdir <run_id> --budget <usd> --record <path> "
                  "[--stages CODE[,CODE...]] [--capture json|stream-json] "
                  "[--benchmark-dir <dir>] [--prompts-dir <dir>] "
                  "[--without-arm real|skip] [--arm with|without|both] [--config-dir <dir>] "
                  "[--workdir-root <dir>] [--wait-on-limit | --no-wait-on-limit]")
            print("[--provider claude|codex] (default: claude)")
            sys.exit(0)
        if a in ("--wait-on-limit", "--no-wait-on-limit"):
            wait_on_limit = a == "--wait-on-limit"
            i += 1
            continue
        if a in ("--workdir", "--budget", "--record", "--stages", "--capture",
                 "--benchmark-dir", "--prompts-dir", "--without-arm", "--arm", "--config-dir",
                 "--workdir-root", "--provider"):
            if i + 1 >= len(argv):
                die(f"bench-live: {a} needs a value", 64)
            value = argv[i + 1]
            i += 2
            if a == "--provider":
                provider = value
            elif a == "--workdir":
                workdir = value
            elif a == "--budget":
                try:
                    budget = float(value)
                except ValueError:
                    die(f"bench-live: --budget must be a number, got '{value}'", 64)
            elif a == "--record":
                record = value
            elif a == "--stages":
                stages_arg = value
            elif a == "--capture":
                capture_arg = value
            elif a == "--benchmark-dir":
                benchmark_dir_arg = value
            elif a == "--without-arm":
                without_arm_arg = value
            elif a == "--arm":
                arm_arg = value
            elif a == "--config-dir":
                config_dir_arg = value
            elif a == "--workdir-root":
                workdir_root_arg = value
            else:
                prompts_dir_arg = value
        else:
            die(f"bench-live: unknown arg '{a}'", 64)

    if workdir is None or budget is None or record is None:
        die("bench-live: --workdir, --budget and --record are required", 64)
    if provider not in ("claude", "codex"):
        die("bench-live: --provider must be claude or codex", 64)
    if not math.isfinite(budget) or budget <= 0:
        die("bench-live: --budget must be finite and positive", 64)
    if not workdir or os.path.basename(workdir) != workdir or workdir in (".", ".."):
        die("bench-live: --workdir must be a run identifier", 64)

    stages = budget_mod.PIPELINE_STAGES
    if stages_arg is not None:
        requested = [s.strip().upper() for s in stages_arg.split(",") if s.strip()]
        if not requested:
            die("bench-live: --stages needs at least one stage code", 64)
        for code in requested:
            if code not in dispatch_mod.STAGE_TABLE:
                die(f"bench-live: unknown stage code '{code}' (valid: "
                    + ",".join(budget_mod.PIPELINE_STAGES) + ")", 64)
        # Preserve canonical pipeline order regardless of user order.
        stages = [s for s in budget_mod.PIPELINE_STAGES if s in requested]

    if capture_arg not in (dispatch_mod.CAPTURE_JSON, dispatch_mod.CAPTURE_STREAM_JSON):
        die(f"bench-live: --capture must be json or stream-json, got '{capture_arg}'", 64)

    # Refused here, before the credential probe and any dispatch, so a usage slip
    # never costs a run.
    try:
        selection = baseline_mod.resolve_arm_selection(
            arm_arg, without_arm_arg,
            baseline_mod.stages_subset(stages, budget_mod.PIPELINE_STAGES))
    except baseline_mod.ArmSelectionError as exc:
        die(f"bench-live: {exc}", 64)

    if benchmark_dir_arg is not None:
        benchmark_dir = benchmark_dir_arg
    else:
        # <bench>/results/runs/<mode>/<id>.json → derive <bench>.
        derived = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(record))))
        benchmark_dir = derived if os.path.exists(os.path.join(derived, "live", "prompts")) \
            else os.path.join(os.getcwd(), "benchmark")

    try:
        rc = dispatch_mod.dispatch(
            workdir=workdir, budget=budget, record_path=record, benchmark_dir=benchmark_dir,
            prompts_dir=prompts_dir_arg, stages=stages, capture_mode=capture_arg,
            selection=selection, config_dir=config_dir_arg,
            workdir_root=workdir_root_arg, wait_on_limit=wait_on_limit, provider=provider,
            arm_record_dir=os.path.join(
                os.path.dirname(os.path.dirname(os.path.abspath(record))), "live-arm"))
    except Exception as exc:  # noqa: BLE001 — top-level CLI guard
        die(f"bench-live: dispatch failed: {exc}", 1)
    sys.exit(rc)


if __name__ == "__main__":
    main(sys.argv[1:])
